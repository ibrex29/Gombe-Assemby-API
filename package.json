{
  "name": "electromon-api-assembly",
  "version": "0.1.0",
  "description": "Electromon national APC campaign management API",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "prebuild": "pnpm db:generate && pnpm shared:build && pnpm db:build",
    "build": "nest build",
    "dev": "pnpm db:generate && pnpm shared:build && pnpm db:build && nest build && nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "pnpm db:generate && pnpm shared:build && pnpm db:build && jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "pnpm db:generate && pnpm shared:build && pnpm db:build && jest --config ./test/jest-e2e.json",
    "db:generate": "pnpm --dir db generate",
    "db:build": "pnpm --dir db build",
    "db:migrate": "pnpm --dir db migrate",
    "db:migrate:deploy": "pnpm --dir db migrate:deploy",
    "db:seed": "pnpm --dir db seed",
    "db:seed:demo": "pnpm --dir db seed:demo",
    "db:seed:full": "pnpm --dir db seed:full",
    "db:seed:production:apc": "pnpm --dir db seed:production:apc",
    "db:seed:production:national": "pnpm --dir db seed:production:national",
    "db:seed:production:pantamiyya": "pnpm --dir db seed:production:pantamiyya",
    "db:studio": "pnpm --dir db studio",
    "shared:build": "pnpm --dir shared build",
    "postinstall": "pnpm --dir db install && pnpm --dir shared install"
  },
  "dependencies": {
    "@electromon/db": "link:./db",
    "@electromon/shared": "link:./shared",
    "@google-cloud/vision": "^6.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "firebase-admin": "^14.2.0",
    "ioredis": "^5.5.0",
    "multer": "^2.2.0",
    "nestjs-pino": "^4.6.1",
    "node-sql-parser": "^5.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
