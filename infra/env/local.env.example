# =============================================================================
# LOCAL — API infrastructure + optional API container
# Copy:  cp infra/env/local.env.example .env
# =============================================================================

NODE_ENV=development
COMPOSE_PROJECT_NAME=electromon-api-national-local
COMPOSE_NETWORK_NAME=electromon

# PostgreSQL — reuse the shared Electromon Postgres, separate database
POSTGRES_USER=electromon
POSTGRES_PASSWORD=electromon
POSTGRES_DB=electromon_national
POSTGRES_PORT=5432
DATABASE_URL=postgresql://electromon:electromon@localhost:5432/electromon_national?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_USER=electromon
RABBITMQ_PASSWORD=electromon
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://electromon:electromon@localhost:5672

# MinIO (S3-compatible)
S3_ACCESS_KEY=electromon
S3_SECRET_KEY=electromonsecret
S3_BUCKET=electromon-national
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT — change in production
JWT_ACCESS_SECRET=local-dev-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=local-dev-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API
API_PORT=3005
API_URL=http://localhost:3005
API_PUBLIC_URL=http://localhost:3005
CORS_ORIGIN=*
LOG_LEVEL=debug

# Observability (optional — make infra-obs-up)
GRAFANA_PORT=3030
GRAFANA_USER=admin
GRAFANA_PASSWORD=electromon
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
# Leave empty locally so /metrics stays open; set in staging/prod
# METRICS_TOKEN=
# ALERT_SLACK_WEBHOOK_URL=

# Push notifications (optional locally — inbox still works without FCM)
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_PATH=
# FCM_DRY_RUN=true

# =============================================================================
# AI engine (assistant + social listening + EC8A photo reading)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=          # https://openrouter.ai/keys
# AI_MODEL=minimax/minimax-m3  # OpenRouter model slug
# While unset, POST /api/v1/ai/assistant/chat returns 503 (expected).
#
# EC8A photo reading (replaces Google Cloud Vision). Vision-capable model:
# AI_OCR_MODEL=google/gemini-2.5-flash
# Voice incident STT (defaults to openai/whisper-large-v3 when unset):
# AI_STT_MODEL=openai/whisper-large-v3
# Falls back to AI_MODEL, then google/gemini-2.5-flash.
#
# Read-only DB for assistant SQL sandbox (run: make db-ai-role after migrate)
AI_READONLY_DB_PASSWORD=electromon_ai
AI_READONLY_DATABASE_URL=postgresql://electromon_ai_readonly:electromon_ai@localhost:5432/electromon_national?schema=public
#
SOCIAL_INGEST_TOKEN=dev-ingest-token
# AI_SOCIAL_MODEL=             # leave empty → posts stored as UNKNOWN
# SUPPORTED_STATE_CODES=       # comma-separated; empty = all states
#
# AI Early Warning sweep (the triage scoring engine). Off unless enabled.
TRIAGE_SWEEP_ENABLED=false
TRIAGE_SWEEP_INTERVAL_SEC=900  # seconds between sweeps; minimum 60
TRIAGE_ELECTION_MODE=true      # time-sensitive scoring (coverage, staleness)
#
# Pulseforge social listening. Read-only key; unset = mood stays
# "not measured" and the risk engine renormalises without it.
# PULSEFORGE_API_KEY=
# Dirty-scope drain: how fast an incident or submission reaches the board.
TRIAGE_DIRTY_DRAIN_SEC=45
# Polling-unit snapshot history kept, in days. Ward and above are never pruned.
TRIAGE_PU_SNAPSHOT_RETENTION_DAYS=14
#
# Hourly status-update reminders to PU agents, ward officers, and LGA officers.
PULSE_REMINDER_ENABLED=true
PULSE_REMINDER_INTERVAL_SEC=60
# PULSE_REMINDER_SKIP_RECENT_MINUTES=50

# WhatsApp via Termii — leave unset on Assembly. Live webhook is Governorship.
# TERMII_API_KEY=
# TERMII_SECRET_KEY=
# TERMII_DEVICE_ID=

# File uploads (EC8A photos, incident attachments) — Cloudinary in production
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or set the three fields separately:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=electromon/uploads
# Voice incident clips are stored under ${CLOUDINARY_FOLDER}/voice
