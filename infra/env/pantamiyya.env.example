# Pantamiyya — fully isolated Gombe governorship stack
# Copy to .env on the Pantamiyya deploy directory (~/Pantamiyya-API on droplet).
#
# This stack has its OWN Postgres, Redis, RabbitMQ, and MinIO.
# It does NOT share data with the national A4A API.

# --- geo + election scope ---
DEPLOYMENT_STATE_CODE=GO
DEPLOYMENT_CLIENT_PARTY_CODE=PDP
IREV_ELECTION_ID=6407d9bfce35006e92156f2e
IREV_ELECTION_LABEL="Gombe Governorship Election"
IREV_ELECTION_TYPE=GOVERNORSHIP
IREV_ASSEMBLY_ELECTION_ID=
IREV_ASSEMBLY_ELECTION_LABEL="Gombe State House of Assembly Election"
IREV_FETCH_QUEUE=irev.fetch.pantamiyya
SUPPORTED_STATE_CODES=GO

# --- API ---
PANTAMIYYA_API_PORT=5301
PANTAMIYYA_API_PUBLIC_URL=https://api.pantamiyya.alphabetandnumbers.com
PANTAMIYYA_CORS_ORIGIN=https://pantamiyya.alphabetandnumbers.com

# --- isolated infra secrets (generate unique values; do NOT reuse national DB password) ---
PANTAMIYYA_POSTGRES_USER=electromon
PANTAMIYYA_POSTGRES_DB=electromon_pantamiyya
PANTAMIYYA_POSTGRES_PASSWORD=CHANGE_ME_pantamiyya_postgres
PANTAMIYYA_RABBITMQ_USER=electromon
PANTAMIYYA_RABBITMQ_PASSWORD=CHANGE_ME_pantamiyya_rabbit
PANTAMIYYA_S3_ACCESS_KEY=electromon_pantamiyya
PANTAMIYYA_S3_SECRET_KEY=CHANGE_ME_pantamiyya_minio
PANTAMIYYA_S3_BUCKET=electromon-pantamiyya
PANTAMIYYA_CLOUDINARY_FOLDER=electromon/pantamiyya/uploads

# --- first-boot seed (director login for governorship campaign) ---
# PANTAMIYYA_RUN_SEED=true
# PANTAMIYYA_SEED_ADMIN_PASSWORD=CHANGE_ME_min_12_chars
# PANTAMIYYA_SEED_ADMIN_EMAIL=director@pantamiyya.ng
# PANTAMIYYA_SEED_ADMIN_PHONE=+2348000000101

# --- shared app secrets (JWT/OCR can match national or be separate) ---
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars
IREV_ENABLED=true
OPENROUTER_API_KEY=
AI_MODEL=minimax/minimax-m3
AI_OCR_MODEL=minimax/minimax-m3
AI_READONLY_DB_PASSWORD=CHANGE_ME_ai_readonly
# Written automatically by deploy-pantamiyya-droplet.sh; run setup-ai-readonly.sh once after first deploy.
# AI_READONLY_DATABASE_URL=postgresql://electromon_ai_readonly:...@postgres:5432/electromon_pantamiyya?schema=public
GOOGLE_CLOUD_VISION_CREDENTIALS=

# WhatsApp via Termii stays UNSET on Assembly. Point Termii at the Governorship API.

