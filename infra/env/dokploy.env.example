# Paste into Dokploy → Environment (not committed).
# DATABASE_URL / RABBITMQ_DEFAULT_PASS / MINIO_ROOT_* must be set — compose
# injects this file with env_file and does not interpolate secrets.

NODE_ENV=production
COMPOSE_PROJECT_NAME=electromon-production

POSTGRES_USER=electromon
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=electromon
DATABASE_URL=postgresql://electromon:CHANGE_ME@postgres:5432/electromon?schema=public

REDIS_URL=redis://redis:6379

RABBITMQ_USER=electromon
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_DEFAULT_USER=electromon
RABBITMQ_DEFAULT_PASS=CHANGE_ME
RABBITMQ_URL=amqp://electromon:CHANGE_ME@rabbitmq:5672

S3_ACCESS_KEY=electromon
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=electromon
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=electromon
MINIO_ROOT_PASSWORD=CHANGE_ME

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

METRICS_TOKEN=CHANGE_ME
API_PORT=3002
API_PUBLIC_URL=https://api.electromon.ng
CORS_ORIGIN=https://app.electromon.ng
LOG_LEVEL=info
RUN_SEED=false

# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_PATH=
# FCM_DRY_RUN=true

# AI engine — see infra/env/production.env.example for full block
# OPENROUTER_API_KEY=
# AI_MODEL=minimax/minimax-m3
# AI_OCR_MODEL=google/gemini-2.5-flash
# AI_READONLY_DB_PASSWORD=
# AI_READONLY_DATABASE_URL=postgresql://electromon_ai_readonly:PASSWORD@postgres:5432/electromon?schema=public
# SOCIAL_INGEST_TOKEN=
# AI_SOCIAL_MODEL=
# SUPPORTED_STATE_CODES=

# AI Early Warning sweep (the triage scoring engine). Off unless explicitly enabled.
TRIAGE_SWEEP_ENABLED=false
# Seconds between sweeps; minimum 60. Election day wants 120-300.
TRIAGE_SWEEP_INTERVAL_SEC=900
# Election mode enables the time-sensitive components (reporting coverage, staleness).
TRIAGE_ELECTION_MODE=true
#
# Pulseforge social listening. Read-only key; unset = mood stays
# "not measured" and the risk engine renormalises without it.
# PULSEFORGE_API_KEY=
# Dirty-scope drain: how fast an incident or submission reaches the board.
TRIAGE_DIRTY_DRAIN_SEC=45
# Polling-unit snapshot history kept, in days. Ward and above are never pruned.
TRIAGE_PU_SNAPSHOT_RETENTION_DAYS=14
#
# Hourly status-update reminders to PU agents, ward officers, and LGA officers.
PULSE_REMINDER_ENABLED=false
PULSE_REMINDER_INTERVAL_SEC=60
