# =============================================================================
# STAGING — full Docker stack (API + edge + obs; web joins same network)
# Copy to project root:  cp infra/env/staging.env.example .env
# =============================================================================

NODE_ENV=staging
COMPOSE_PROJECT_NAME=electromon-staging
COMPOSE_NETWORK_NAME=electromon-staging

# PostgreSQL
POSTGRES_USER=electromon
POSTGRES_PASSWORD=CHANGE_ME_staging_db_password
POSTGRES_DB=electromon_staging

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_USER=electromon
RABBITMQ_PASSWORD=CHANGE_ME_staging_rabbitmq_password
RABBITMQ_URL=amqp://electromon:CHANGE_ME_staging_rabbitmq_password@rabbitmq:5672

# MinIO / S3
S3_ACCESS_KEY=electromon_staging
S3_SECRET_KEY=CHANGE_ME_staging_s3_secret
S3_BUCKET=electromon-staging
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000

# JWT — MUST change before deploy (openssl rand -base64 48)
JWT_ACCESS_SECRET=CHANGE_ME_staging_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_staging_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Metrics scrape token (Prometheus Bearer) — openssl rand -hex 32
METRICS_TOKEN=CHANGE_ME_staging_metrics_token

# API (internal; public via Caddy)
API_PORT=3001
CORS_ORIGIN=https://staging.electromon.ng

# Caddy edge
WEB_HOST=staging.electromon.ng
API_HOST=api-staging.electromon.ng
ACME_EMAIL=ops@electromon.ng
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Observability
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_staging_grafana_password
GRAFANA_PORT=3030
GRAFANA_ROOT_URL=http://127.0.0.1:3030
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_SLACK_CHANNEL=#electromon-alerts

# Web (build args for electromon-web)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api-staging.electromon.ng
NEXT_PUBLIC_WS_URL=https://api-staging.electromon.ng

# Seed demo data on first staging migrate
RUN_SEED=true

# AI engine (optional — endpoints return 503 "not configured" while unset)
# OPENROUTER_API_KEY=
# AI_MODEL=
# Read-only role for the assistant's SQL sandbox. The role is created by
# migration; run `make db-ai-role` once per environment to give it LOGIN.
# AI_READONLY_DB_PASSWORD=
# AI_READONLY_DATABASE_URL=
# Social listening ingest token (unset = ingest endpoint disabled)
# SOCIAL_INGEST_TOKEN=
# Sentiment model; unset = posts stored and marked UNKNOWN (pipeline still runs)
# AI_SOCIAL_MODEL=

# State onboarding allowlist — comma-separated state codes. Unset/empty = all states.
# SUPPORTED_STATE_CODES=

# AI Early Warning sweep (the triage scoring engine). Off unless explicitly enabled.
TRIAGE_SWEEP_ENABLED=false
# Seconds between sweeps; minimum 60. Election day wants 120-300.
TRIAGE_SWEEP_INTERVAL_SEC=900
# Election mode enables the time-sensitive components (reporting coverage, staleness).
TRIAGE_ELECTION_MODE=true
#
# Pulseforge social listening. Read-only key; unset = mood stays
# "not measured" and the risk engine renormalises without it.
# PULSEFORGE_API_KEY=
# Dirty-scope drain: how fast an incident or submission reaches the board.
TRIAGE_DIRTY_DRAIN_SEC=45
# Polling-unit snapshot history kept, in days. Ward and above are never pruned.
TRIAGE_PU_SNAPSHOT_RETENTION_DAYS=14
#
# Hourly status-update reminders to PU agents, ward officers, and LGA officers.
PULSE_REMINDER_ENABLED=false
PULSE_REMINDER_INTERVAL_SEC=60
