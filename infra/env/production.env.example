# =============================================================================
# PRODUCTION — full Docker stack (DigitalOcean / VPS)
# Copy to project root:  cp infra/env/production.env.example .env
# NEVER commit this file with real secrets.
# =============================================================================

NODE_ENV=production
COMPOSE_PROJECT_NAME=electromon-production
COMPOSE_NETWORK_NAME=electromon-production

# PostgreSQL — use strong passwords; prefer managed DB in production
POSTGRES_USER=electromon
POSTGRES_PASSWORD=CHANGE_ME_production_db_password
POSTGRES_DB=electromon

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_USER=electromon
RABBITMQ_PASSWORD=CHANGE_ME_production_rabbitmq_password
RABBITMQ_URL=amqp://electromon:CHANGE_ME_production_rabbitmq_password@rabbitmq:5672

# S3 — local MinIO OR DigitalOcean Spaces
S3_ACCESS_KEY=CHANGE_ME_spaces_access_key
S3_SECRET_KEY=CHANGE_ME_spaces_secret_key
S3_BUCKET=electromon-production
S3_REGION=nyc3
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

# External managed PostgreSQL (required for make infra-prod-external-up)
# DATABASE_URL=postgresql://user:pass@host:25060/electromon?sslmode=require

# JWT — openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_production_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_production_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Metrics scrape token — openssl rand -hex 32
METRICS_TOKEN=CHANGE_ME_production_metrics_token

# API (internal; public via Caddy)
API_PORT=3001
# Comma-separated browser origins, or * for any. Include DigitalOcean App Platform frontends.
# Example: https://nigeria4asiwaju-kq2eo.ondigitalocean.app,https://nigeria4asiwaju.iexportcalc.com
CORS_ORIGIN=*

# Caddy edge
WEB_HOST=app.electromon.ng
API_HOST=api.electromon.ng
ACME_EMAIL=ops@electromon.ng
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Observability
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_production_grafana_password
GRAFANA_PORT=3030
GRAFANA_ROOT_URL=http://127.0.0.1:3030
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_SLACK_CHANNEL=#electromon-alerts

# Web (build args for electromon-web)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.electromon.ng
NEXT_PUBLIC_WS_URL=https://api.electromon.ng

# Google Cloud Vision is no longer used for EC8A reads (safe to omit).
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vision-service-account.json
# GOOGLE_CLOUD_VISION_CREDENTIALS=

# Never seed production automatically with the demo seed
RUN_SEED=false

# Manual production APC bootstrap (pnpm db:seed:production:apc)
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=director@danmodi.ng
# SEED_ADMIN_PHONE=+2348000000001
# SEED_CANDIDATE_EMAIL=
# SEED_CANDIDATE_PHONE=
# SEED_STATE_OFFICER_EMAIL=
# SEED_STATE_OFFICER_PHONE=

# =============================================================================
# AI engine (assistant + social listening + EC8A photo reading)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=          # https://openrouter.ai/keys — required for assistant + EC8A reads
# AI_MODEL=minimax/minimax-m3  # strong tool-calling model on OpenRouter
# AI_OCR_MODEL=google/gemini-2.5-flash  # vision model for EC8A photos
#
# Read-only role for assistant SQL (migration creates role; run: make db-ai-role)
AI_READONLY_DB_PASSWORD=CHANGE_ME_ai_readonly_password
AI_READONLY_DATABASE_URL=postgresql://electromon_ai_readonly:CHANGE_ME_ai_readonly_password@postgres:5432/electromon?schema=public
#
SOCIAL_INGEST_TOKEN=CHANGE_ME_social_ingest_token
# AI_SOCIAL_MODEL=
# SUPPORTED_STATE_CODES=       # comma-separated; empty = all states
#
# AI Early Warning sweep (the triage scoring engine). Off unless enabled.
TRIAGE_SWEEP_ENABLED=false
TRIAGE_SWEEP_INTERVAL_SEC=900  # seconds between sweeps; minimum 60
TRIAGE_ELECTION_MODE=true      # time-sensitive scoring (coverage, staleness)
#
# Pulseforge social listening. Read-only key; unset = mood stays
# "not measured" and the risk engine renormalises without it.
# PULSEFORGE_API_KEY=
# PULSEFORGE_BASE_URL=https://pulseforge.vercel.app/api/v1
#
# National Situation Room Redis cache (seconds). Map overview + race-analytics only.
SITUATION_ROOM_CACHE_TTL_SEC=10
# Dirty-scope drain: how fast an incident or submission reaches the board.
TRIAGE_DIRTY_DRAIN_SEC=45
# Polling-unit snapshot history kept, in days. Ward and above are never pruned.
TRIAGE_PU_SNAPSHOT_RETENTION_DAYS=14
#
# Hourly status-update reminders to PU agents, ward officers, and LGA officers.
PULSE_REMINDER_ENABLED=false
PULSE_REMINDER_INTERVAL_SEC=60

# INEC IReV comparison (official portal vs agent captures)
IREV_ENABLED=true
IREV_BASE_URL=https://dolphin-app-sleqh.ondigitalocean.app/api/v1
IREV_ELECTION_ID=63f8f25b594e164f8146a213
IREV_FETCH_RATE_LIMIT=30
IREV_SWEEP_INTERVAL_MS=3600000
IREV_CATALOG_INTERVAL_MS=20000
IREV_CATALOG_WARD_BATCH=8
IREV_CATALOG_STALE_MS=21600000
IREV_STATS_CACHE_MS=300000

# File uploads (EC8A photos, incident attachments) — required in production
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=electromon/uploads
